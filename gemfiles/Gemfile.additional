# TODO: We should revisit whether we want to test all these libraries
gem "delayed_job", require: false
gem "delayed_job_active_record", require: false
gem "excon"
gem "faraday"
# Graphiti 2+ requires Ruby 3.2+; Ruby 3.1 jobs set GRAPHITI_VERSION to test 1.x.
gem "graphiti", ENV["GRAPHITI_VERSION"] || "~> 2"
gem "graphql", "~> 2.5.0"
gem "httpclient"
gem "rexml"
gem "sequel", "> 0"
gem "sidekiq", ENV['SIDEKIQ_VERSION'] || "~> 8"
gem "sqlite3", "~> 2.1.0"
gem "tilt"
gem "haml"
gem "redis"
gem "aws_lambda_ric"

if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.1")
  gem "net-smtp", require: "false"
end
